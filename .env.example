# Скопируйте в .env и заполните. .env НЕ коммитить!

# Подписанная GET-ссылка организаторов (кнопка на стр. 3 гайда). Это секрет.
ORGANIZER_API_URL=

# mock — тестовый ответ без модели (UI помечает его как тестовый); real — настоящая модель
EVALUATOR_MODE=mock

# Провайдер: anthropic (Claude, официальный SDK) | openai_compat (OpenAI, Gemini, OpenRouter, vLLM)
LLM_PROVIDER=anthropic
# Пусто = claude-opus-5-5. Дешевле: claude-sonnet-5-5, claude-haiku-5-5. Для Gemini: gemini-3.8-flash
LLM_MODEL=
# Claude: ключ из https://platform.claude.com (или `ant auth login`)
ANTHROPIC_API_KEY=
# Claude: low | medium | high | xhigh | max
LLM_EFFORT=medium

# Только для openai_compat: {LLM_BASE_URL}/chat/completions
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=
LLM_API_KEY=
# Цены за 1 млн токенов, $. 0 = взять из таблицы известных моделей Claude
LLM_PRICE_INPUT_PER_M=0
LLM_PRICE_OUTPUT_PER_M=0
LLM_TIMEOUT_S=300
LLM_MAX_RETRIES=2
BATCH_CONCURRENCY=4

# CQA_DB_PATH=data/cqa.sqlite3
