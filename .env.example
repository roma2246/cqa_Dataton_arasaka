# Скопируйте в .env и заполните. .env НЕ коммитить!

# Подписанная GET-ссылка организаторов (кнопка на стр. 3 гайда). Это секрет.
ORGANIZER_API_URL=

# mock — тестовый ответ без модели (UI помечает его как тестовый); real — настоящая модель
EVALUATOR_MODE=mock

# Модель команды: Gemini 3.8 Flash через OpenAI-совместимый endpoint.
# Провайдер: openai_compat (Gemini, OpenAI, OpenRouter, vLLM) | anthropic (Claude, официальный SDK)
LLM_PROVIDER=openai_compat
LLM_MODEL=gemini-3.8-flash
# Ключ Gemini: https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Глубина размышлений: low | medium | high (Gemini: reasoning_effort; Claude: effort)
LLM_EFFORT=medium
# Цены за 1 млн токенов, $. 0 = из встроенной таблицы (gemini-3.8-flash: 0.75 / 3.75 до 31.12.2026)
LLM_PRICE_INPUT_PER_M=0
LLM_PRICE_OUTPUT_PER_M=0

# Только для LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_TIMEOUT_S=300
LLM_MAX_RETRIES=2
BATCH_CONCURRENCY=4

# CQA_DB_PATH=data/cqa.sqlite3
