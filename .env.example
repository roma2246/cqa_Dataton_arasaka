# Скопируйте в .env и заполните. .env НЕ коммитить!

# Подписанная GET-ссылка организаторов (кнопка на стр. 3 гайда). Это секрет.
ORGANIZER_API_URL=

# mock — тестовый ответ без модели (UI помечает его как тестовый); real — настоящая модель
EVALUATOR_MODE=mock

# Вариант А (бесплатно, локально): Ollama — см. docs/LOCAL_MODEL.md
#   LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen3:8b  LLM_FALLBACK_MODEL=  LLM_TIMEOUT_S=600
# Вариант Б (облако): Gemini 3.6 Flash (основная, ~10 с на диалог), 3.8 Flash — резервная. Обе $0.75/$3.75.
# Провайдер: openai_compat (Gemini, OpenAI, OpenRouter, vLLM) | anthropic (Claude, официальный SDK)
LLM_PROVIDER=openai_compat
LLM_MODEL=gemini-3.6-flash
# Резервная модель, если основная перегружена (HTTP 503/429)
LLM_FALLBACK_MODEL=gemini-3.8-flash
# Ключ Gemini: https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Глубина размышлений: low | medium | high (Gemini: reasoning_effort; Claude: effort)
LLM_EFFORT=medium
# Цены за 1 млн токенов, $. 0 = из встроенной таблицы (gemini-3.8-flash: 0.75 / 3.75 до 31.12.2026)
LLM_PRICE_INPUT_PER_M=0
LLM_PRICE_OUTPUT_PER_M=0

# Только для LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_TIMEOUT_S=120
# Не больше N запросов к модели в минуту (0 — без ограничения). Бесплатный тариф Gemini: ставьте 10
LLM_RPM=0
# «Дообучение»: исправления проверяющего подставляются в промпт как прецеденты (on | off)
LLM_CALIBRATION=on
LLM_CALIBRATION_PER_CRITERION=3
LLM_MAX_RETRIES=2
BATCH_CONCURRENCY=4

# CQA_DB_PATH=data/cqa.sqlite3

# Локальная модель: = OLLAMA_CONTEXT_LENGTH (0 — не проверять)
LLM_CONTEXT_TOKENS=0
# Название команды для results.json
TEAM_NAME=Arasaka
