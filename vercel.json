{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{backend/cqa/**,backend/prompts/**,frontend/**,data/checklists/**,data/fixtures/**,data/assistant_kb.json,data/assistant_faq.json,evaluation/reports/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}